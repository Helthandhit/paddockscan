  async function deleteGarageVehicle(id) {
    if (!state.user || !db || !storage) return;
    const item = state.cloudGarage.find(vehicle => vehicle.id === id);
    if (!item || !confirm('Delete this vehicle from your cloud Garage? Existing public posts and submissions will remain.')) return;
    setLoading(true, 'Deleting vehicle from cloud Garage…');
    try {
      const paths = [item.originalStoragePath, item.cutoutStoragePath, item.webStoragePath, item.thumbnailStoragePath].filter(Boolean);
      await Promise.all(paths.map(path => storage.ref(path).delete().catch(error => {
        if (error?.code !== 'storage/object-not-found') throw error;
      })));
      const ref = db.collection('users').doc(state.user.uid).collection('garage').doc(id);
      const history = await ref.collection('history').get().catch(() => null);
      if (history) await Promise.all(history.docs.map(doc => doc.ref.delete()));
      await ref.delete();
      state.cloudGarage = state.cloudGarage.filter(vehicle => vehicle.id !== id);
      renderAll();
      toast('Vehicle deleted from cloud Garage');
    } catch (error) {
      toast(friendlyFirebaseError(error, 'Could not delete the Garage vehicle.'));
    } finally { setLoading(false); }
  }

